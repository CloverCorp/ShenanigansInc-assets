VertexLitGeneric
{
	$basetexture models\enhancedbots\heavy\heavy_bot_arms_red
	$bumpmap models\enhancedbots\heavy\heavy_bot_arms_normal
	
	$phong 1
//	$phongexponent 200
	$phongboost 2
	$phongfresnelranges	"[.5 .7 1]"
	$phongexponenttexture models\enhancedbots\heavy\heavy_bot_arms_exp

	$lightwarptexture models\lightwarps\robot_lightwarp
	$phongdisablehalflambert 1

	$blendtintbybasealpha 1
	$basemapalphaphongmask 0

	$rimlight 1						
	$rimlightexponent 1				
	$rimlightboost 2
	$rimmask 1
	$yellow 0
	$one 1

	// Cloaking
	$cloakPassEnabled 1

	Proxies
	{
		invis
		{
		}
		AnimatedTexture
		{
			animatedtexturevar $detail
			animatedtextureframenumvar $detailframe
			animatedtextureframerate 30
		}
		BurnLevel
		{
			resultVar $detailblendfactor
		}
		YellowLevel
		{
			resultVar $yellow
		}
		Equals
		{
			srcVar1  $yellow
			resultVar $color2
		}
		"ConVarEx"
		{
 			"ConVar" "tf2c_player_nohalflambert"
  			"0"
  	  		{
  	   			"$PhongDisableHalfLambert"  "0"
  	   			"$LightWarpTexture"         "models\lightwarps\robot_lightwarp"
  	  		}
  	 		"1"
  	 		{
  	 			"$PhongDisableHalfLambert"  "1"
   				"$LightWarpTexture"         "models\player\pyro\lambert_lightwarp"
  	 		}
		}
	}
}
