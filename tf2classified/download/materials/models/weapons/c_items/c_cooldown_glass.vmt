"VertexlitGeneric"
{
	"$baseTexture" "models/weapons/c_items/c_cooldown_glass"
	"$bumpmap" "models\weapons\c_items\c_cooldown_glass_normals"


	"$translucent" "1"
	
	"$envmap" "env_cubemap"
	"$envmaptint" "[2 5 5]"

	"$phong" "1"
	"$phongexponent" "65"
	"$phongfresnelranges" "[.1 1 1]"
	"$lightwarptexture" "models/lightwarps/jarate_lightwarp"
	"$phongboost" "100"

	"$rimlight" "1"						
	"$rimlightexponent" "2"				
	"$rimlightboost" "10"

	"360?$color2" "[ 0.6 0.6 0.6 ]"

	"$glowcolor" "1"

	// Cloaking
	"$cloakPassEnabled" "1"
	"$sheenPassEnabled" "1"

	"$sheenmap" 		"cubemaps\cubemap_sheen001"
	"$sheenmapmask" 		"Effects\AnimatedSheen\animatedsheen0"
	"$sheenmaptint" 		"[ 1 1 1 ]"
	"$sheenmapmaskframe" 	"0"
	"$sheenindex" 		"0"

	"$yellow" "0"

	"Proxies"
	{
		"AnimatedWeaponSheen"
		{
			"animatedtexturevar" 		"$sheenmapmask"
			"animatedtextureframenumvar" 	"$sheenmapmaskframe"
			"animatedtextureframerate" 		"40"
		}
		"invis"
		{
		}
		"ModelGlowColor"
		{
			"resultVar" "$glowcolor"
		}
		"Equals"
		{
			"srcVar1"  "$glowcolor"
			"resultVar" "$selfillumtint"
		}
		"Equals"
		{
			"srcVar1"  "$glowcolor"
			"resultVar" "$color2"
		}
		"YellowLevel"
		{
			"resultVar" "$yellow"
		}
		"Multiply"
		{
			"srcVar1" "$color2"
			"srcVar2" "$yellow"
			"resultVar" "$color2"
		}
	}


}
