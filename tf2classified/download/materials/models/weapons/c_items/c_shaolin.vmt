"VertexLitGeneric"
{
	"$basetexture" "models\weapons\c_items\c_shaolin"
	"$bumpmap" "models\weapons\c_items\c_shaolin_normal"

	"$phong" "1"
	"$phongexponent" "100"
	"$phongboost" "10"	
	"$lightwarptexture" "models\lightwarps\weapon_lightwarp"
	"$phongfresnelranges"	"[.5 3 5]"
	"$halflambert" "1"
	
	// Rim lighting parameters
	"$rimlight" "1"												// To enable rim lighting (requires phong)
	"$rimlightexponent" "8"										// Exponent for phong component of rim lighting	
	"$rimlightboost" ".8"										// Boost for ambient cube component of rim lighting
}



