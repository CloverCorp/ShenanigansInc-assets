"VertexLitGeneric"
{
	"$baseTexture" "models/weapons/c_models/c_livenload/c_livenload"
	"$basemapalphaphongmask" 1

	"$phong" "1"
	"$phongexponent" "15"
	"$phongboost" "3"	
	"$lightwarptexture" "models/lightwarps/weapon_lightwarp"
	"$phongfresnelranges"	"[.25 .5 1]"
       "$phongdisablehalflambert" "1"

	"$tempvar" "0"

	"$basephongexponent" "15"
	"$basephongboost" "3"

	"$commadd_phongexponent" "30"
	"$commadd_phongboost" 	"22.5"
	"$commweapon"		"0"

	"$rimlight" "1"
	"$rimlightexponent" "4"	
	"$rimlightboost" "1.5"

	"$glowcolor" "1"

	// Cloaking
	"$cloakPassEnabled" "1"
	"$sheenPassEnabled" "1"

	"$sheenmap" 		"cubemaps/cubemap_sheen001"
	"$sheenmapmask" 		"Effects/AnimatedSheen/animatedsheen0"
	"$sheenmaptint" 		"[ 1 1 1 ]"
	"$sheenmapmaskframe" 	"0"
	"$sheenindex" 		"0"

	"$yellow" "0"

	"Proxies"
	{
        "ConVarEx"
        {
             "ConVar" "tf2c_player_nohalflambert"
              "0"
                {
                     "$PhongDisableHalfLambert"  "0"
                }
              "1"
               {
                   "$PhongDisableHalfLambert"  "1"
               }
        }
		"AnimatedWeaponSheen"
		{
			"animatedtexturevar" 		"$sheenmapmask"
			"animatedtextureframenumvar" 	"$sheenmapmaskframe"
			"animatedtextureframerate" 		"40"
		}
		"invis"
		{
		}
		"ModelGlowColor"
		{
			"resultVar" "$glowcolor"
		}
		"Equals"
		{
			"srcVar1"  "$glowcolor"
			"resultVar" "$selfillumtint"
		}
		"Equals"
		{
			"srcVar1"  "$glowcolor"
			"resultVar" "$color2"
		}
		"YellowLevel"
		{
			"resultVar" "$yellow"
		}
		"Multiply"
		{
			"srcVar1" "$color2"
			"srcVar2" "$yellow"
			"resultVar" "$color2"
		}
        "WeaponSkin"
        {
        }
	}
}