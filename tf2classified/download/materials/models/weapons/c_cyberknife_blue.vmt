"VertexLitGeneric"
{
	"$basetexture"	"models/weapons/c_cyberknife_blue"
    "$basemapalphaphongmask" "1"
    "$selfillum" "1"
	"$selfillummask"	"models/weapons/c_cyberknife_illum"
	
	
	"$phong" "1"
	//comment out to use the exponent mask
	"$phongexponent" "25"
	"$phongboost" "3"	



	

	
	//scales up the exponent texture which usually only has about 120 levels of exponent
//	"$phongexponentfactor"  "195"
	"$phongalbedotint" "1"
	
	"$lightwarptexture" "models/lightwarps/weapon_lightwarp"
			
	"$phongfresnelranges"	"[.25 .5 1]"
	"$halflambert" "1"
	"$glowcolor" "1"
	
	"$envmap" "env_cubemap"
	"$envmaptint" "[.02 .02 .02]"
	
	"$tempvar" "0"

	//comment out to use the exponent mask
	"$basephongexponent" "15"
	"$basephongboost" "10"

	"$basemapalphaphongmask" "0"
	"$basealphaenvmapmask" "0"
	
	"$rimlight" "1"						
	"$rimlightexponent" "1"				
	"$rimlightboost" "1.5"
//	"$rimmask" "1"
	

	// Cloaking
	"$cloakPassEnabled" "1"
	"$sheenPassEnabled" "1"

	"$sheenmap" 		"cubemaps\cubemap_sheen001"
	"$sheenmapmask" 		"Effects\AnimatedSheen\animatedsheen0"
	"$sheenmaptint" 		"[ 1 1 1 ]"
	"$sheenmapmaskframe" 	"0"
	"$sheenindex" 		"0"

	"$yellow" "0"

	"Proxies"
	{
		"AnimatedWeaponSheen"
		{
			"animatedtexturevar" 		"$sheenmapmask"
			"animatedtextureframenumvar" 	"$sheenmapmaskframe"
			"animatedtextureframerate" 		"40"
		}
		"invis"
		{
		}
		"ModelGlowColor"
		{
			"resultVar" "$glowcolor"
		}
		"Equals"
		{
			"srcVar1"  "$glowcolor"
			"resultVar" "$selfillumtint"
		}
		"Equals"
		{
			"srcVar1"  "$glowcolor"
			"resultVar" "$color2"
		}
		"YellowLevel"
		{
			"resultVar" "$yellow"
		}
		"Multiply"
		{
			"srcVar1" "$color2"
			"srcVar2" "$yellow"
			"resultVar" "$color2"
		}		
		"Sine"
		{
			"resultVar"	"$selfillumtint[2]" 
		    "sineperiod"	"3"
			"sinemin"	    "1"
			"sinemax"	    "2"
		}
	}
}
