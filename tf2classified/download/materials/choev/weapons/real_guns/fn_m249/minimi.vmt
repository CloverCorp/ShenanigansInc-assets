"VertexlitGeneric"
{
//Main
	$basetexture					"ChoEv/Weapons/Real_Guns/FN_M249/Minimi_D"
	$bumpmap						"ChoEv/Weapons/Real_Guns/FN_M249/Minimi_N"

//Other
	$glowcolor						"1"
	$normalmapalphaphongmask		"1"
	$lightwarptexture				"models/lightwarps/weapon_lightwarp"

//Phong
	$phong							"1"
	$phongexponent					"75"
	$phongboost						"0.5"		
	$phongfresnelranges				"[.25 .5 1]"

//Rimlight
	$rimlight						"1"
	$rimlightexponent				"10"	
	$rimlightboost					"1"

//Cloaking
	$cloakPassEnabled				"1"
	$sheenPassEnabled				"1"

//Killstreak Sheen
	$sheenmap						"cubemaps\cubemap_sheen001"
	$sheenmapmask					"Effects\AnimatedSheen\animatedsheen0"
	$sheenmaptint					"[ 1 1 1 ]"
	$sheenmapmaskframe				"0"
	$sheenindex						"0"

	$yellow							"0"

	"Proxies"
	{
		"AnimatedWeaponSheen"
		{
			"animatedtexturevar" 		"$sheenmapmask"
			"animatedtextureframenumvar" 	"$sheenmapmaskframe"
			"animatedtextureframerate" 		"40"
		}
		"invis"
		{
		}
		"ModelGlowColor"
		{
			"resultVar" "$glowcolor"
		}
		"Equals"
		{
			"srcVar1"  "$glowcolor"
			"resultVar" "$selfillumtint"
		}
		"Equals"
		{
			"srcVar1"  "$glowcolor"
			"resultVar" "$color2"
		}
		"YellowLevel"
		{
			"resultVar" "$yellow"
		}
		"Multiply"
		{
			"srcVar1" "$color2"
			"srcVar2" "$yellow"
			"resultVar" "$color2"
		}
	}
}